<!-- catalogo.dtd · Reglas del catálogo de BiciRuta S.L. -->

<!-- La raíz tiene uno o más productos (+) -->
<!ELEMENT catalogo (producto+)>
<!-- Nombre de la tienda y fecha de actualización, obligatorios -->
<!ATTLIST catalogo
  tienda      CDATA #REQUIRED
  actualizado CDATA #REQUIRED>

<!-- Orden fijo: nombre, precio y stock; descripción y características opcionales (?) -->
<!ELEMENT producto (nombre, precio, stock, descripcion?, caracteristicas?)>
<!-- ref: obligatoria y única (ID) · categoria: solo tres valores · proveedor: opcional -->
<!ATTLIST producto
  ref       ID                                  #REQUIRED
  categoria (bicicleta | accesorio | recambio)  #REQUIRED
  proveedor CDATA                               #IMPLIED>

<!ELEMENT nombre (#PCDATA)>

<!ELEMENT precio (#PCDATA)>
<!-- moneda: EUR o USD; si no se pone, vale EUR -->
<!ATTLIST precio
  moneda (EUR | USD) "EUR">

<!ELEMENT stock (#PCDATA)>
<!ELEMENT descripcion (#PCDATA)>

<!-- Características: talla y peso, los dos opcionales -->
<!ELEMENT caracteristicas (talla?, peso?)>
<!ELEMENT talla (#PCDATA)>
<!ELEMENT peso (#PCDATA)>
<!-- El peso siempre está en kg: valor fijo -->
<!ATTLIST peso
  unidad CDATA #FIXED "kg">
